# Copia a .env.staging.local y rellena. SOLO para el proyecto de staging.
# Nunca uses credenciales de producción aquí.

# Conexión directa (pooler) al proyecto de staging para aplicar schema + RLS.
# La obtienes en Supabase Dashboard → Project Settings → Database → Connection
# string → "Transaction" / "Session" pooler, esquema postgres. Incluye password.
STAGING_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Proyecto staging (Project Settings → API)
STAGING_SUPABASE_URL=https://<ref>.supabase.co
STAGING_SUPABASE_ANON_KEY=eyJhbGciOi... (anon)
STAGING_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi... (service_role — SOLO en tu máquina)

# Usuario "dueño" que simula al dueño real (SUPERADMIN). Debe ser distinto al
# dueño real de producción para no confundir sesiones.
OWNER_EMAIL=staging-owner@example.com
OWNER_PASSWORD='CambiaEstaContrasena1!'

# (Opcional) Usuario de alcance reducido para probar que solo ve su sucursal.
SCOPED_EMAIL=staging-scoped@example.com
SCOPED_PASSWORD='CambiaEstaContrasena2!'
SCOPED_SUCURSAL_ID=SUC-B